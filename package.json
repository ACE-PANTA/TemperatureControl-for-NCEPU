{
  "name": "tempecontrol",
  "version": "1.0.0",
  "description": "温控炉上位机系统",
  "main": "./out/main/index.js",
  "productName": "温控系统",
  "author": "dreamtech.team",
  "homepage": "https://electron-vite.org",
  "win": {
    "artifactName": "${productName}Setup.${version}.exe",
    "icon": "resources/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64",
          "ia32"
        ]
      }
    ]
  },
  "nsis":{
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "cross-env NODE_OPTIONS= electron-vite preview",
    "dev": "cross-env NODE_OPTIONS= electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "electron:generate-icons": "electron-icon-builder --input=./resources/logo.png --output=build --flatten"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "axios": "^1.8.4",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.3.9",
    "element-plus": "^2.9.7",
    "marked": "^15.0.12",
    "serialport": "^13.0.0",
    "simple-peer": "^9.9.0",
    "vue-router": "^4.5.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^3.0.0",
    "eslint": "^9.20.1",
    "eslint-plugin-vue": "^9.32.0",
    "pinia": "^3.0.1",
    "prettier": "^3.5.1",
    "vite": "^6.1.0",
    "vue": "^3.5.13"
  }
}
